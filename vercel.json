{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "backend/api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/api/index.py"
    },
    {
      "src": "/health",
      "dest": "backend/api/index.py"
    },
    {
      "src": "/alerts/(.*)",
      "dest": "backend/api/index.py"
    },
    {
      "src": "/stats",
      "dest": "backend/api/index.py"
    },
    {
      "src": "/plume/(.*)",
      "dest": "backend/api/index.py"
    },
    {
      "src": "/facilities",
      "dest": "backend/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}
