# VulcanGrid Environment Configuration

# Demo Mode (true = 100% offline synthetic stream; false = live NASA FIRMS & Overpass)
DEMO_MODE=true

# NASA FIRMS API Key (Get free key at https://firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRMS_MAP_KEY=your_nasa_firms_api_key_here

# Database Settings
POSTGRES_USER=vulcan
POSTGRES_PASSWORD=vulcan_pass
POSTGRES_DB=vulcangrid
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://vulcan:vulcan_pass@postgres:5432/vulcangrid

# Redis & Celery
REDIS_URL=redis://redis:6379/0

# API Settings
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
